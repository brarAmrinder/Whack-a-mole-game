<?xml version="1.0" encoding="utf-8"?>
<!--
    This layout displays the leaderboard screen for the game.

    Main Sections:
    1. Top banner image showing the game logo
    2. Leaderboard title
    3. Leaderboard entries (top 5 players), each showing:
       - Player avatar
       - Player name
       - Player score
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".LeaderboardActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="centerInside"
        android:src="@drawable/img_wakamole_text" >
    </ImageView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/purple"
        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
        android:text="Leaderboard" >
    </TextView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="9"
        android:layout_margin="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/iv_leaderboard_avatar1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" >
            </ImageView>

            <TextView
                android:id="@+id/tv_leaderboard_name1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="0dp" >
            </TextView>

            <TextView
                android:id="@+id/tv_leaderboard_score1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="10dp" >
            </TextView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/iv_leaderboard_avatar2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" >
            </ImageView>

            <TextView
                android:id="@+id/tv_leaderboard_name2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="0dp" >
            </TextView>

            <TextView
                android:id="@+id/tv_leaderboard_score2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="10dp" >
            </TextView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/iv_leaderboard_avatar3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" >
            </ImageView>

            <TextView
                android:id="@+id/tv_leaderboard_name3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="0dp" >
            </TextView>

            <TextView
                android:id="@+id/tv_leaderboard_score3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="10dp" >
            </TextView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/iv_leaderboard_avatar4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" >
            </ImageView>

            <TextView
                android:id="@+id/tv_leaderboard_name4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="0dp" >
            </TextView>

            <TextView
                android:id="@+id/tv_leaderboard_score4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="10dp" >
            </TextView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" >

            <ImageView
                android:id="@+id/iv_leaderboard_avatar5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" >
            </ImageView>

            <TextView
                android:id="@+id/tv_leaderboard_name5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="0dp" >
            </TextView>

            <TextView
                android:id="@+id/tv_leaderboard_score5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:padding="10dp" >
            </TextView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>